flowchart LR
  subgraph PAY["Money path: one ACID transaction, then the rail"]
    direction LR
    C["Rupay Wallet / Cashier till<br/>(PWA)"] --> G["API gateway<br/>JWT · RBAC · idempotency<br/>correlation ID"]
    G --> R["Risk rules<br/>KYC tier · velocity · watch-list"]
    R -- "PASS" --> L[("Double-entry ledger<br/>append-only · balanced")]
    L -- "credit, E2E id" --> RA["Raast rail<br/>simulated, RailPort"]
  end
  subgraph CTRL["Controls, recovery, evidence"]
    direction LR
    H(["Compliance officer<br/>release / reject"])
    W["Recovery worker<br/>status enquiry, same E2E"]
    RC["Reconciliation<br/>control totals · 7 categories"] --> AI["AI triage<br/>suggest only"] --> OF(["Ops maker · Finance checker"])
    O[("Outbox")] --> N["Notifier · Mission Control<br/>(operator console)"]
  end
  subgraph EXT["Themes 1–5"]
    direction TB
    K["Onboarding & KYC<br/>liveness · face match<br/>registry (simulated)"]
    AS["Rupay Assistant<br/>reads own ledger data<br/>redacts secrets"]
    GR["Green pot · offsets<br/>2100 ↔ 2110 journals<br/>offset = normal payment"]
    SV["Super app services<br/>bills · top-up · shop · takaful<br/>order = normal payment"]
    SB["Stablecoin sandbox · OFF by default<br/>test tokens · simulated chain<br/>no rupee conversion"]
  end
  SV -- "payment request" --> G
  GR -- "journal" --> L
  C --> K
  K -- "referral" --> H
  AS -- "handoff" --> OF
  R -- "HOLD" --> H
  H -- "release" --> L
  RA -- "ack / enquiry" --> W
  W --> L
  L --> O
  RA -- "settlement file" --> RC
  classDef human fill:#efe9ff,stroke:#7c5cff,color:#2b1b6b
  classDef store fill:#e8f7ef,stroke:#0a7a46,color:#0b3d24
  classDef ext fill:#eef2f7,stroke:#64748b,color:#1f2937
  class H,OF human
  class L,O store
  class RA ext
  class K,AS,GR,SV,SB ext
