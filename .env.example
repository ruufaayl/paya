# Copy to .env and fill in. Never commit .env.
PAYA_JWT_SECRET=replace-with-32+-random-characters
PAYA_DB_PASSWORD=paya-local-only
PAYA_DEMO_MODE=true
# Settlement cut-off (UTC hour). After it, a line missing from today's Raast file is a timing difference, not a
# break. For a demo or rehearsal after 21:00 Pakistan time, set 24 so the "Missing line" scene opens a case.
PAYA_SETTLEMENT_CUTOFF_UTC_HOUR=16
# Local development without Docker (Postgres on port 5433):
PAYA_DATABASE_URL=postgresql+psycopg://paya@localhost:5433/paya
