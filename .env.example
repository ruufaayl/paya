# Copy to .env and fill in. Never commit .env.
PAYA_JWT_SECRET=replace-with-32+-random-characters
PAYA_DB_PASSWORD=paya-local-only
# The API connects as this restricted role (data privileges only); migrations use the owner above (ADR-015).
PAYA_APP_DB_PASSWORD=replace-with-a-different-password
PAYA_DEMO_MODE=true
# Settlement cut-off (UTC hour). After it, a line missing from today's Raast file is a timing difference, not a
# break. For a demo or rehearsal after 21:00 Pakistan time, set 24 so the "Missing line" scene opens a case.
PAYA_SETTLEMENT_CUTOFF_UTC_HOUR=16
# Stablecoin sandbox (Theme 5). Keep false except to demonstrate the sandbox: worthless test tokens on a
# simulated chain, never converted to rupees. Stablecoin payments are not permitted for Paya (PVARA/SBP).
PAYA_STABLECOIN_SANDBOX=false
# Staff MFA (ADR-017). Empty = required unless demo mode (then opt-in). Key: base64 of 32 random bytes,
# e.g. python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
PAYA_MFA_ENFORCED=
PAYA_MFA_ENCRYPTION_KEY=
# Local development without Docker (Postgres on port 5433):
PAYA_DATABASE_URL=postgresql+psycopg://paya@localhost:5433/paya
