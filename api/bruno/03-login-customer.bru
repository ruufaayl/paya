meta {
  name: 03 Login customer (Sara)
  type: http
  seq: 3
}
post {
  url: {{baseUrl}}/v1/auth/login
  body: json
  auth: none
}
body:json {
  { "username": "sara", "password": "{{password}}" }
}
script:post-response {
  bru.setVar("customerToken", res.body.access_token);
}
tests {
  test("200", function() { expect(res.status).to.equal(200); });
}
