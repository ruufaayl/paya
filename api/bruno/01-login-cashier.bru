meta {
  name: 01 Login cashier (Ayesha)
  type: http
  seq: 1
}
post {
  url: {{baseUrl}}/v1/auth/login
  body: json
  auth: none
}
body:json {
  { "username": "ayesha.cashier", "password": "{{password}}" }
}
script:post-response {
  bru.setVar("cashierToken", res.body.access_token);
}
tests {
  test("200 and CASHIER role", function() {
    expect(res.status).to.equal(200);
    expect(res.body.role).to.equal("CASHIER");
  });
}
