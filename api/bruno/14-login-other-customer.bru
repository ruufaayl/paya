meta {
  name: 14 Login a different customer (Omar)
  type: http
  seq: 14
}
post {
  url: {{baseUrl}}/v1/auth/login
  body: json
  auth: none
}
body:json {
  { "username": "omar", "password": "{{password}}" }
}
script:post-response {
  bru.setVar("otherToken", res.body.access_token);
}
tests {
  test("200", function() { expect(res.status).to.equal(200); });
}
