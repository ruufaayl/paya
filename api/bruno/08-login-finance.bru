meta {
  name: 08 Login finance (Rufayl)
  type: http
  seq: 8
}
post {
  url: {{baseUrl}}/v1/auth/login
  body: json
  auth: none
}
body:json {
  { "username": "rufayl.finance", "password": "{{password}}" }
}
script:post-response {
  bru.setVar("financeToken", res.body.access_token);
}
tests {
  test("200", function() { expect(res.status).to.equal(200); });
}
