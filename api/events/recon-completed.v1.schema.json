{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paya reconciliation completed (v1)",
  "type": "object",
  "required": [
    "event_id",
    "seq",
    "type",
    "schema_version",
    "correlation_id",
    "occurred_at",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique per event; de-duplication key"
    },
    "seq": {
      "type": "integer"
    },
    "schema_version": {
      "const": 1
    },
    "aggregate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "type": {
      "const": "recon.completed"
    },
    "payload": {
      "type": "object",
      "required": [
        "run_id",
        "file_id",
        "business_date",
        "records",
        "match_rate"
      ],
      "properties": {
        "run_id": {
          "type": "string"
        },
        "file_id": {
          "type": "string"
        },
        "business_date": {
          "type": "string",
          "format": "date"
        },
        "records": {
          "type": "integer"
        },
        "value_total_minor": {
          "type": "integer"
        },
        "match_rate": {
          "type": "number"
        },
        "MATCHED": {
          "type": "integer"
        },
        "MISSING_EXTERNAL": {
          "type": "integer"
        },
        "MISSING_INTERNAL": {
          "type": "integer"
        },
        "DUPLICATE_EXTERNAL": {
          "type": "integer"
        },
        "AMOUNT_MISMATCH": {
          "type": "integer"
        },
        "STATUS_MISMATCH": {
          "type": "integer"
        },
        "TIMING_DIFFERENCE": {
          "type": "integer"
        }
      }
    }
  },
  "x-owner": "Paya",
  "x-delivery": "at-least-once via transactional outbox; consumers de-duplicate on event_id"
}